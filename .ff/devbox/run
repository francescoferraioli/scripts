#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=/dev/null
source "${FF_SCRIPT_HOME}/.lib/devbox.sh"
devbox_prepend_if_omitted "$0" "$@"

if [[ $# -eq 0 ]]; then
  echo "usage: ff devbox run [--force] <devbox>|all [<devbox>|all...] -- <command...>" >&2
  exit 1
fi

force=false
devboxes=()
while [[ $# -gt 0 && "$1" != "--" ]]; do
  case "$1" in
    --force)
      force=true
      shift
      ;;
    all)
      read -r -a all_devboxes <<< "$(ff devbox all)"
      devboxes+=("${all_devboxes[@]}")
      shift
      ;;
    *)
      devboxes+=("$1")
      shift
      ;;
  esac
done

if [[ ${#devboxes[@]} -eq 0 ]]; then
  echo "error: at least one devbox name is required" >&2
  echo "usage: ff devbox run [--force] <devbox>|all [<devbox>|all...] -- <command...>" >&2
  exit 1
fi

if [[ $# -eq 0 ]]; then
  echo "error: missing -- before command" >&2
  echo "usage: ff devbox run [--force] <devbox>|all [<devbox>|all...] -- <command...>" >&2
  exit 1
fi

shift

if [[ $# -eq 0 ]]; then
  echo "error: missing command after --" >&2
  exit 1
fi

remote_script() {
  if [[ $# -eq 1 ]]; then
    # One quoted string: run as shell (supports &&, ||, pipes, etc.)
    printf 'export PATH="$HOME/scripts:$PATH"; exec </dev/null; %s' "$1"
  else
    local cmd
    cmd=$(printf ' %q' "$@")
    printf 'export PATH="$HOME/scripts:$PATH"; exec </dev/null; %s' "${cmd:1}"
  fi
}

prefix_output() {
  local devbox=$1
  while IFS= read -r line || [[ -n "${line:-}" ]]; do
    printf '%s: %s\n' "$devbox" "$line"
  done
}

if [[ "$force" != true ]]; then
  running=()
  for devbox in "${devboxes[@]}"; do
    if devbox_skip_unless_running "$devbox"; then
      running+=("$devbox")
    fi
  done
  if [[ ${#running[@]} -eq 0 ]]; then
    exit 0
  fi
  devboxes=("${running[@]}")
fi

for devbox in "${devboxes[@]}"; do
  (
    script=$(remote_script "$@")
    ssh -o BatchMode=yes -o ConnectTimeout=300 \
      -o ClearAllForwardings=yes -o PermitLocalCommand=no \
      "coder.frankief/$devbox" \
      bash -lc "$(printf '%q' "$script")" 2>&1 | prefix_output "$devbox"
  ) &
done
wait
