#!/usr/bin/env bash
# Start Claude with merge-pr on a canva devbox (no PR branch worktree).
#
# Usage:
#   ff devbox merge-pr <pr-url>
#
# Examples:
#   ff devbox merge-pr https://github.com/canva/canva/pull/12345
#
# merge-pr only retries Buildkite jobs and posts bot comments; it never
# commits. Skip `ff devbox go` (branch resolve, where scan, worktree create)
# and SSH to claude, then hand off to `ff c merge-pr` for the tmux session
# in ~/work/canva. Bare PR numbers are not accepted; use the full GitHub URL.
set -euo pipefail

# shellcheck source=/dev/null
source "${FF_SCRIPT_HOME}/.lib/devbox.sh"
# shellcheck source=/dev/null
source "${FF_SCRIPT_HOME}/.lib/github-pr.sh"

DEFAULT_DEVBOX=claude

usage() {
  echo "usage: ff devbox merge-pr <pr-url>" >&2
  exit 1
}

[[ $# -eq 1 ]] || usage
[[ -n "$1" ]] || usage
is_github_pr_url "$1" || usage

pr_url=$1

devbox_require_running "$DEFAULT_DEVBOX" || exit 1

remote_script=$(
  cat <<EOF
set -euo pipefail
export PATH="\$HOME/scripts:\$PATH"
cd "\$HOME/work/canva"
exec ff c merge-pr $(printf '%q' "$pr_url")
EOF
)

exec ssh -t \
  -o ConnectTimeout=30 \
  "coder.frankief/${DEFAULT_DEVBOX}" \
  bash -lc "$(printf '%q' "$remote_script")"
