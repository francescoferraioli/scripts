#!/usr/bin/env bash
# Start Claude with merge-pr on a canva devbox (no PR branch worktree).
#
# Usage:
#   ff devbox merge-pr <pr-url>
#
# Examples:
#   ff devbox merge-pr https://github.com/canva/canva/pull/12345
#
# merge-pr only retries Buildkite jobs and posts bot comments; it never
# commits. Skip `ff devbox go` (branch resolve, where scan, worktree create)
# and attach a PR-scoped tmux session in ~/work/canva on totti.
# Bare PR numbers are not accepted; use the full GitHub URL.
set -euo pipefail

# shellcheck source=/dev/null
source "${FF_SCRIPT_HOME}/.lib/github-pr.sh"

DEFAULT_DEVBOX=totti

usage() {
  echo "usage: ff devbox merge-pr <pr-url>" >&2
  exit 1
}

[[ $# -eq 1 ]] || usage
[[ -n "$1" ]] || usage
is_github_pr_url "$1" || usage

pr_url=$1

if [[ "$pr_url" =~ /pull/([0-9]+) ]]; then
  pr_number="${BASH_REMATCH[1]}"
else
  echo "error: could not parse PR number from: ${pr_url}" >&2
  exit 1
fi

exec ff devbox attach "$DEFAULT_DEVBOX" "merge-pr-${pr_number}" /home/coder/work/canva \
  -- ff c c "Please merge-pr $pr_url"
