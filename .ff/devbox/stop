#!/usr/bin/env bash
# Stop one or more Coder devbox workspaces.
#
# Usage:
#   ff devbox stop [--safe] <devbox>|all [<devbox>|all...]
set -euo pipefail

# shellcheck source=/dev/null
source "${FF_SCRIPT_HOME}/.lib/devbox.sh"
devbox_prepend_if_omitted "$0" "$@"

usage() {
  echo "usage: ff devbox stop [--safe] <devbox>|all [<devbox>|all...]" >&2
  exit 1
}

[[ $# -ge 1 ]] || usage

if ! command -v coder >/dev/null 2>&1; then
  echo "error: coder CLI not found; install Coder CLI and run 'coder login'" >&2
  exit 1
fi

safe=false
devboxes=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --safe)
      safe=true
      shift
      ;;
    all)
      read -r -a all_devboxes <<< "$(ff devbox all)"
      devboxes+=("${all_devboxes[@]}")
      shift
      ;;
    -h | --help)
      cat <<EOF
usage: ff devbox stop [--safe] <devbox>|all [<devbox>|all...]

Stop Coder devbox workspaces.

Options:
  --safe  Only stop devboxes that are running and idle (see ff devbox ai-status)
EOF
      exit 0
      ;;
    *)
      devboxes+=("$1")
      shift
      ;;
  esac
done

if [[ ${#devboxes[@]} -eq 0 ]]; then
  usage
fi

if [[ "$safe" == true ]]; then
  to_stop=()
  for devbox in "${devboxes[@]}"; do
    status=$(ff devbox status --state "$devbox" 2>/dev/null || echo unknown)
    if [[ "$status" != "running" ]]; then
      echo "$devbox: skipping (status: $status)" >&2
      continue
    fi

    ai_status=$(ff devbox ai-status --state "$devbox" 2>/dev/null || echo unknown)
    if [[ "$ai_status" != "idle" ]]; then
      echo "$devbox: skipping (ai-status: ${ai_status})" >&2
      continue
    fi

    to_stop+=("$devbox")
  done

  if [[ ${#to_stop[@]} -eq 0 ]]; then
    echo "no devboxes to stop" >&2
    exit 0
  fi

  devboxes=("${to_stop[@]}")
fi

prefix_output() {
  local devbox=$1
  while IFS= read -r line || [[ -n "${line:-}" ]]; do
    printf '%s: %s\n' "$devbox" "$line"
  done
}

pids=()
for devbox in "${devboxes[@]}"; do
  (
    {
      echo "stopping ${devbox}..."
      coder stop -y "$devbox"
    } 2>&1 | prefix_output "$devbox"
  ) &
  pids+=($!)
done

failed=0
for pid in "${pids[@]}"; do
  wait "$pid" || failed=1
done
exit "$failed"
