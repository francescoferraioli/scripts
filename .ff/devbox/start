#!/usr/bin/env bash
# Start one or more Coder devbox workspaces.
#
# Usage:
#   ff devbox start <devbox>|all [<devbox>|all...]
set -euo pipefail

# shellcheck source=/dev/null
source "${FF_SCRIPT_HOME}/.lib/devbox.sh"
devbox_prepend_if_omitted "$0" "$@"

usage() {
  echo "usage: ff devbox start <devbox>|all [<devbox>|all...]" >&2
  exit 1
}

[[ $# -ge 1 ]] || usage

if ! command -v coder >/dev/null 2>&1; then
  echo "error: coder CLI not found; install Coder CLI and run 'coder login'" >&2
  exit 1
fi

devboxes=()
while [[ $# -gt 0 ]]; do
  if [[ "$1" == "all" ]]; then
    read -r -a all_devboxes <<< "$(ff devbox all)"
    devboxes+=("${all_devboxes[@]}")
  else
    devboxes+=("$1")
  fi
  shift
done

if [[ ${#devboxes[@]} -eq 0 ]]; then
  usage
fi

prefix_output() {
  local devbox=$1
  while IFS= read -r line || [[ -n "${line:-}" ]]; do
    printf '%s: %s\n' "$devbox" "$line"
  done
}

pids=()
for devbox in "${devboxes[@]}"; do
  (
    {
      echo "starting ${devbox}..."
      coder start -y "$devbox"
    } 2>&1 | prefix_output "$devbox"
  ) &
  pids+=($!)
done

failed=0
for pid in "${pids[@]}"; do
  wait "$pid" || failed=1
done
exit "$failed"
