#!/usr/bin/env bash
# Find which of your Coder devboxes have a local git branch.
#
# Usage:
#   ff devbox where <branch-or-pr-url>
#
# Checks each name from `ff devbox all` via `ff devbox run-canva` for a
# local refs/heads/<branch> in ~/work/canva. PR URLs are resolved to the
# head branch via `ff gh branch` first.
set -euo pipefail

# shellcheck source=/dev/null
source "${FF_SCRIPT_HOME}/.lib/github-pr.sh"

usage() {
  echo "usage: ff devbox where <branch-or-pr-url>" >&2
  exit 1
}

[[ $# -eq 1 ]] || usage
[[ -n "$1" ]] || usage

target=$1

if is_github_pr_url "$target"; then
  branch=$(ff gh branch "$target")
  if [[ -z "$branch" ]]; then
    echo "error: could not resolve PR head branch for: ${target}" >&2
    exit 1
  fi
else
  branch=$target
fi

quoted_branch=$(printf '%q' "$branch")
output=$(ff devbox run-canva all -- "git show-ref --verify --quiet refs/heads/${quoted_branch} && echo yes") || true

matches=()
while IFS= read -r line || [[ -n "${line:-}" ]]; do
  [[ "$line" == *": yes" ]] || continue
  matches+=("${line%%:*}")
done <<< "${output:-}"

if [[ ${#matches[@]} -eq 0 ]]; then
  echo "branch '${branch}' is not a local branch on any running devbox" >&2
  if [[ -n "${output:-}" ]]; then
    printf '%s\n' "$output" >&2
    exit 2
  fi
  exit 1
fi

printf '%s\n' "${matches[@]}"
