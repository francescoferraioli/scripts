#!/usr/bin/env bash
# Find which of your Coder devboxes have a git branch checked out.
#
# Usage:
#   ff devbox where <branch-or-pr-url>
#
# Checks each name from `ff devbox all` via `ff devbox run-canva` for a
# canva worktree with that branch checked out. PR URLs are resolved to the
# head branch via `ff gh branch` first.
set -euo pipefail

# shellcheck source=/dev/null
source "${FF_SCRIPT_HOME}/.lib/github-pr.sh"

usage() {
  echo "usage: ff devbox where <branch-or-pr-url>" >&2
  exit 1
}

[[ $# -eq 1 ]] || usage
[[ -n "$1" ]] || usage

target=$1

if is_github_pr_url "$target"; then
  branch=$(ff gh branch "$target")
  if [[ -z "$branch" ]]; then
    echo "error: could not resolve PR head branch for: ${target}" >&2
    exit 1
  fi
else
  branch=$target
fi

# Braced so run-canva's `cd ~/work/canva && …` keeps the whole script as one
# compound command (not only the first line).
remote_cmd=$(
  cat <<EOF
{
  BRANCH=$(printf '%q' "$branch")
  wt_path=
  while IFS= read -r line || [[ -n "\${line:-}" ]]; do
    if [[ "\$line" == "worktree "* ]]; then
      wt_path=\${line#worktree }
    elif [[ "\$line" == "branch "* ]]; then
      ref=\${line#branch }
      if [[ "\$ref" == "refs/heads/\$BRANCH" && -n "\${wt_path:-}" ]]; then
        printf '%s\n' "\$wt_path"
      fi
    elif [[ -z "\$line" ]]; then
      wt_path=
    fi
  done < <(git worktree list --porcelain)
}
EOF
)

output=$(ff devbox run-canva all -- "$remote_cmd") || true

if ! grep -q ': /' <<<"${output:-}"; then
  echo "branch '${branch}' is not checked out on any devbox" >&2
  if [[ -n "${output:-}" ]]; then
    printf '%s\n' "$output" >&2
    exit 2
  fi
  exit 1
fi

printf '%s\n' "$output"
