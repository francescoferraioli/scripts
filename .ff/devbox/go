#!/usr/bin/env bash
# Drop into a canva worktree + tmux session for a branch on a Coder devbox.
#
# Usage:
#   ff devbox go <branch-or-pr-url> [-- <command...>]
#
# <branch-or-pr-url> may be a git branch name, or a GitHub PR URL
# (https://github.com/owner/repo/pull/n). PR URLs are resolved to the PR head
# branch via `ff gh branch` before the worktree/tmux setup.
#
# Picks the target with `ff devbox where`:
#   - If the branch is already checked out on a devbox, use that box + worktree
#   - Otherwise default to totti and create ~/work/<sanitized-branch> if needed
#
# On the chosen box:
#   - Ensure the worktree exists
#   - Hand off to `ff devbox attach --local` for the tmux session (optional command)
set -euo pipefail

# shellcheck source=/dev/null
source "${FF_SCRIPT_HOME}/.lib/github-pr.sh"

DEFAULT_DEVBOX=totti

usage() {
  echo "usage: ff devbox go <branch-or-pr-url> [-- <command...>]" >&2
  exit 1
}

[[ $# -ge 1 ]] || usage
[[ -n "$1" ]] || usage

target=$1
shift

if is_github_pr_url "$target"; then
  branch=$(ff gh branch "$target")
  if [[ -z "$branch" ]]; then
    echo "error: could not resolve PR head branch for: ${target}" >&2
    exit 1
  fi
else
  branch=$target
fi

cmd=()
if [[ $# -gt 0 ]]; then
  [[ "$1" == "--" ]] || usage
  shift
  [[ $# -gt 0 ]] || usage
  cmd=("$@")
fi

sanitize() {
  # Filesystem + tmux-safe name derived from the branch.
  # Slashes and dots become dashes (tmux targets use '.' as a separator).
  local s=$1
  s=${s//\//-}
  s=${s//./-}
  s=${s//[^a-zA-Z0-9_-]/-}
  while [[ "$s" == *--* ]]; do
    s=${s//--/-}
  done
  s=${s#-}
  s=${s%-}
  printf '%s' "$s"
}

name=$(sanitize "$branch")
if [[ -z "$name" ]]; then
  echo "error: branch name sanitizes to an empty worktree name: ${branch}" >&2
  exit 1
fi

devbox=$DEFAULT_DEVBOX
existing_worktree=

set +e
where_out=$(ff devbox where "$branch" 2>/dev/null)
where_status=$?
set -e

if [[ "$where_status" -eq 0 && -n "${where_out:-}" ]]; then
  where_matches=$(grep ': /' <<<"$where_out" || true)
  if [[ -n "$where_matches" ]]; then
    first=$(head -n1 <<<"$where_matches")
    match_count=$(grep -c ': /' <<<"$where_matches" || true)
    devbox=${first%%:*}
    existing_worktree=${first#*: }
    if [[ "$match_count" -gt 1 ]]; then
      echo "warning: branch '${branch}' found on ${match_count} devboxes; using ${devbox}" >&2
    fi
    echo "using existing checkout on ${devbox}: ${existing_worktree}" >&2
  fi
fi

if [[ -z "$existing_worktree" ]]; then
  # Reserved sibling dirs under ~/work on Canva Coder boxes (create path only).
  case "$name" in
    canva | docs | dynamic-config | infrastructure | scripts | README.md)
      echo "error: '${name}' is reserved under ~/work; pick a different branch name mapping" >&2
      exit 1
      ;;
  esac
  echo "no existing checkout found; using ${devbox}" >&2
fi

# Quoted suffix for `ff devbox attach --local "$NAME" "$WORKTREE"[ -- cmd...]`
attach_suffix=
if [[ ${#cmd[@]} -gt 0 ]]; then
  attach_suffix=$(printf ' %q' -- "${cmd[@]}")
fi

remote_script=$(
  cat <<EOF
set -euo pipefail

export PATH="\$HOME/scripts:\$PATH"

BRANCH=$(printf '%q' "$branch")
NAME=$(printf '%q' "$name")
EXISTING_WORKTREE=$(printf '%q' "$existing_worktree")
MAIN_REPO="\$HOME/work/canva"

if [[ ! -d "\$MAIN_REPO/.git" && ! -f "\$MAIN_REPO/.git" ]]; then
  echo "error: main canva repo not found at \$MAIN_REPO" >&2
  exit 1
fi

cd "\$MAIN_REPO"

if [[ -n "\$EXISTING_WORKTREE" ]]; then
  WORKTREE="\$EXISTING_WORKTREE"
  if [[ ! -d "\$WORKTREE" ]]; then
    echo "error: expected worktree missing: \$WORKTREE" >&2
    exit 1
  fi
  if ! git -C "\$WORKTREE" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "error: \$WORKTREE is not a git worktree" >&2
    exit 1
  fi
  current=\$(git -C "\$WORKTREE" branch --show-current)
  if [[ "\$current" != "\$BRANCH" ]]; then
    echo "error: \$WORKTREE has branch '\${current:-detached}', not '\$BRANCH'" >&2
    exit 1
  fi
else
  WORKTREE="\$HOME/work/\$NAME"

  # Best-effort: make sure we can see the branch tip on origin.
  git fetch --quiet origin "\$BRANCH" 2>/dev/null || true

  while IFS= read -r line || [[ -n "\${line:-}" ]]; do
    if [[ "\$line" == "worktree "* ]]; then
      wt_path=\${line#worktree }
    elif [[ "\$line" == "branch "* ]]; then
      ref=\${line#branch }
      if [[ "\$ref" == "refs/heads/\$BRANCH" && -n "\${wt_path:-}" && "\$wt_path" != "\$WORKTREE" ]]; then
        echo "error: branch '\$BRANCH' is already checked out in another worktree:" >&2
        echo "  \$wt_path" >&2
        echo "expected path for this script: \$WORKTREE" >&2
        exit 1
      fi
    elif [[ -z "\$line" ]]; then
      wt_path=""
    fi
  done < <(git worktree list --porcelain)

  if [[ -e "\$WORKTREE" ]]; then
    if [[ ! -d "\$WORKTREE" ]]; then
      echo "error: \$WORKTREE exists and is not a directory" >&2
      exit 1
    fi
    if ! git -C "\$WORKTREE" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      echo "error: \$WORKTREE exists but is not a git worktree" >&2
      exit 1
    fi
    current=\$(git -C "\$WORKTREE" branch --show-current)
    if [[ "\$current" != "\$BRANCH" ]]; then
      echo "error: \$WORKTREE exists but has branch '\${current:-detached}', not '\$BRANCH'" >&2
      exit 1
    fi
  else
    echo "creating worktree \$WORKTREE for branch \$BRANCH (canva checkout can take a few minutes)..."
    if git show-ref --verify --quiet "refs/heads/\$BRANCH"; then
      git worktree add "\$WORKTREE" "\$BRANCH"
    elif git show-ref --verify --quiet "refs/remotes/origin/\$BRANCH"; then
      git worktree add -b "\$BRANCH" "\$WORKTREE" "origin/\$BRANCH"
    else
      echo "branch '\$BRANCH' not found; creating from origin/master..."
      git fetch --quiet origin master 2>/dev/null || true
      if ! git show-ref --verify --quiet "refs/remotes/origin/master"; then
        echo "error: origin/master not found; cannot create branch '\$BRANCH'" >&2
        exit 1
      fi
      git worktree add -b "\$BRANCH" "\$WORKTREE" "origin/master"
    fi
  fi
fi

exec ff devbox attach --local "\$NAME" "\$WORKTREE"${attach_suffix}
EOF
)

exec ssh -t \
  -o ConnectTimeout=30 \
  "coder.frankief/${devbox}" \
  bash -lc "$(printf '%q' "$remote_script")"
