#!/usr/bin/env bash
# Run a command in every git worktree for the current repository.
#
# Usage:
#   ff wt run -- <command...>
set -euo pipefail

# shellcheck source=/dev/null
source "${FF_SCRIPT_HOME}/.lib/wt.sh"

usage() {
  echo "usage: ff wt run -- <command...>" >&2
  exit 1
}

[[ $# -gt 0 && "$1" == "--" ]] || usage
shift
[[ $# -gt 0 ]] || usage

wt_run_each -- "$@"
