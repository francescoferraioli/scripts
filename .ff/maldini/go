#!/usr/bin/env bash
# Drop into a Maldini canva worktree + tmux session for a branch.
#
# Usage:
#   ff maldini go <branch-or-pr-url> [-- <command...>]
#
# <branch-or-pr-url> may be a git branch name, or a GitHub PR URL
# (https://github.com/owner/repo/pull/n). PR URLs are resolved to the PR head
# branch via `ff gh branch` before the worktree/tmux setup.
#
# On Maldini (coder.frankief/maldini):
#   - Worktree path: ~/work/<sanitized-branch> (sibling of ~/work/canva)
#   - If the branch is checked out in some other worktree, exit with an error
#   - If the named worktree is missing, create it (local branch, track origin,
#     or create a new branch from origin/master)
#   - Create or attach a tmux session named like the sanitized branch, cwd = worktree
#   - If -- <command...> is given, type that command into the session before attach
set -euo pipefail

# shellcheck source=/dev/null
source "${FF_SCRIPT_HOME}/.lib/github-pr.sh"

DEVBOX=maldini

usage() {
  echo "usage: ff maldini go <branch-or-pr-url> [-- <command...>]" >&2
  exit 1
}

[[ $# -ge 1 ]] || usage
[[ -n "$1" ]] || usage

target=$1
shift

if is_github_pr_url "$target"; then
  branch=$(ff gh branch "$target")
  if [[ -z "$branch" ]]; then
    echo "error: could not resolve PR head branch for: ${target}" >&2
    exit 1
  fi
else
  branch=$target
fi

cmd=()
if [[ $# -gt 0 ]]; then
  [[ "$1" == "--" ]] || usage
  shift
  [[ $# -gt 0 ]] || usage
  cmd=("$@")
fi

sanitize() {
  # Filesystem + tmux-safe name derived from the branch.
  # Slashes and dots become dashes (tmux targets use '.' as a separator).
  local s=$1
  s=${s//\//-}
  s=${s//./-}
  s=${s//[^a-zA-Z0-9_-]/-}
  while [[ "$s" == *--* ]]; do
    s=${s//--/-}
  done
  s=${s#-}
  s=${s%-}
  printf '%s' "$s"
}

name=$(sanitize "$branch")
if [[ -z "$name" ]]; then
  echo "error: branch name sanitizes to an empty worktree name: ${branch}" >&2
  exit 1
fi

# Reserved sibling dirs under ~/work on Canva Coder boxes.
case "$name" in
  canva | docs | dynamic-config | infrastructure | scripts | README.md)
    echo "error: '${name}' is reserved under ~/work; pick a different branch name mapping" >&2
    exit 1
    ;;
esac

cmd_line=
if [[ ${#cmd[@]} -gt 0 ]]; then
  cmd_line=$(printf '%q ' "${cmd[@]}")
  cmd_line=${cmd_line% }
fi

remote_script=$(
  cat <<EOF
set -euo pipefail

BRANCH=$(printf '%q' "$branch")
NAME=$(printf '%q' "$name")
CMD_LINE=$(printf '%q' "$cmd_line")
MAIN_REPO="\$HOME/work/canva"
WORKTREE="\$HOME/work/\$NAME"

if [[ ! -d "\$MAIN_REPO/.git" && ! -f "\$MAIN_REPO/.git" ]]; then
  echo "error: main canva repo not found at \$MAIN_REPO" >&2
  exit 1
fi

cd "\$MAIN_REPO"

# Best-effort: make sure we can see the branch tip on origin.
git fetch --quiet origin "\$BRANCH" 2>/dev/null || true

while IFS= read -r line || [[ -n "\${line:-}" ]]; do
  if [[ "\$line" == "worktree "* ]]; then
    wt_path=\${line#worktree }
  elif [[ "\$line" == "branch "* ]]; then
    ref=\${line#branch }
    if [[ "\$ref" == "refs/heads/\$BRANCH" && -n "\${wt_path:-}" && "\$wt_path" != "\$WORKTREE" ]]; then
      echo "error: branch '\$BRANCH' is already checked out in another worktree:" >&2
      echo "  \$wt_path" >&2
      echo "expected path for this script: \$WORKTREE" >&2
      exit 1
    fi
  elif [[ -z "\$line" ]]; then
    wt_path=""
  fi
done < <(git worktree list --porcelain)

if [[ -e "\$WORKTREE" ]]; then
  if [[ ! -d "\$WORKTREE" ]]; then
    echo "error: \$WORKTREE exists and is not a directory" >&2
    exit 1
  fi
  if ! git -C "\$WORKTREE" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "error: \$WORKTREE exists but is not a git worktree" >&2
    exit 1
  fi
  current=\$(git -C "\$WORKTREE" branch --show-current)
  if [[ "\$current" != "\$BRANCH" ]]; then
    echo "error: \$WORKTREE exists but has branch '\${current:-detached}', not '\$BRANCH'" >&2
    exit 1
  fi
else
  echo "creating worktree \$WORKTREE for branch \$BRANCH (canva checkout can take a few minutes)..."
  if git show-ref --verify --quiet "refs/heads/\$BRANCH"; then
    git worktree add "\$WORKTREE" "\$BRANCH"
  elif git show-ref --verify --quiet "refs/remotes/origin/\$BRANCH"; then
    git worktree add -b "\$BRANCH" "\$WORKTREE" "origin/\$BRANCH"
  else
    echo "branch '\$BRANCH' not found; creating from origin/master..."
    git fetch --quiet origin master 2>/dev/null || true
    if ! git show-ref --verify --quiet "refs/remotes/origin/master"; then
      echo "error: origin/master not found; cannot create branch '\$BRANCH'" >&2
      exit 1
    fi
    git worktree add -b "\$BRANCH" "\$WORKTREE" "origin/master"
  fi
fi

# Exact session name match (leading =).
if tmux has-session -t "=\$NAME" 2>/dev/null; then
  echo "attaching to tmux session \$NAME (cwd should be \$WORKTREE)"
else
  echo "starting tmux session \$NAME in \$WORKTREE"
  tmux new-session -d -s "\$NAME" -c "\$WORKTREE"
  # Let the login shell finish starting before send-keys.
  sleep 1.5
fi

if [[ -n "\$CMD_LINE" ]]; then
  tmux send-keys -t "=\$NAME" "\$CMD_LINE" Enter
fi

exec tmux attach-session -t "=\$NAME"
EOF
)

exec ssh -t \
  -o ConnectTimeout=30 \
  "coder.frankief/${DEVBOX}" \
  bash -lc "$(printf '%q' "$remote_script")"
