#!/bin/sh
# Push with gh as the git credential helper.
#
# Canva git otherwise uses osxkeychain, then git-credential-oauth. Cron cannot
# read or write that keychain item, so every push opens a browser. gh uses
# GH_TOKEN when it is set, and the keyring otherwise.
#
# Usage:
#   ff gh push [git push args...]
#
# Examples:
#   ff gh push
#   ff gh push origin main
set -eu

gh_bin=$(command -v gh) || {
  echo "ff gh push: gh not found on PATH" >&2
  exit 1
}

GIT_TERMINAL_PROMPT=0 git \
  -c credential.helper= \
  -c "credential.helper=!${gh_bin} auth git-credential" \
  push "$@"
