#!/bin/sh
# Print the head branch name for a PR (number or URL).
#
# Usage:
#   ff gh branch <pr>
#
# Examples:
#   ff gh branch 12345
#   ff gh branch https://github.com/owner/repo/pull/12345
set -eu

if [ $# -ne 1 ] || [ -z "$1" ]; then
  echo "usage: ff gh branch <pr>" >&2
  exit 1
fi

gh pr view "$1" --json headRefName -q .headRefName
