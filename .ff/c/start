#!/usr/bin/env bash

# Optional flag before the proxy and pages: t → infra highway tunnel
optional_args=()
while [[ "${1:-}" == "t" ]]; do
  optional_args+=(-t enabled)
  shift
done

env="${1:-prod}"
[[ $# -ge 1 ]] && shift

# Pages are positional args (default to home if none). rspack-dev-server has no -e.
pages=("${@:-home}")

cd ~/work/canva/web
pnpm rspack-dev-server "${pages[@]}" -p "$env" "${optional_args[@]}"
