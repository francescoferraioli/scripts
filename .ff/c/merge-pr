#!/usr/bin/env bash
# Open a Maldini worktree for a PR and start Claude with merge-pr.
#
# Usage:
#   ff c merge-pr <pr>
#
# Examples:
#   ff c merge-pr 12345
#   ff c merge-pr https://github.com/owner/repo/pull/12345
set -euo pipefail

usage() {
  echo "usage: ff c merge-pr <pr>" >&2
  exit 1
}

[[ $# -eq 1 ]] || usage
[[ -n "$1" ]] || usage

pr=$1
branch=$(ff gh branch "$pr")
url=$(gh pr view "$pr" --json url -q .url)

exec ff maldini go "$branch" -- ff c c "Please merge-pr $url"
